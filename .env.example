# Required Telegram credentials
TELEGRAM_TOKEN=replace-with-bot-token

# PostgreSQL used by docker-compose.yml.
# Keep the password URL-safe because it is also embedded in DATABASE_URL.
POSTGRES_DB=crewai
POSTGRES_USER=crewai
POSTGRES_PASSWORD=replace-with-long-postgres-password
DATABASE_URL=postgresql+asyncpg://crewai:replace-with-long-postgres-password@postgres:5432/crewai

# CrewAI-compatible OpenAI/vLLM endpoint.
VLLM_URL=http://host.docker.internal:8000/v1
VLLM_API_KEY=
VLLM_MODEL=replace-with-model-name

# MinIO credentials must match S3_ACCESS_KEY/S3_SECRET_KEY.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace-with-long-minio-password
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=replace-with-long-minio-password
S3_REGION=us-east-1
S3_SKILL_BUCKET=agent-skills

# Optional semantic memory. Leave EMBEDDING_BASE_URL and EMBEDDING_MODEL empty
# until an OpenAI-compatible embedding endpoint is available.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=1536
QDRANT_API_KEY=
QDRANT_MEMORY_COLLECTION=agent_memory

# Optional application settings.
APP_NAME=crewai_telegrambot
ENV=docker
DEBUG=false
ECHO=false
CREWAI_APPROVAL_PERSISTENCE_PATH=/app/.crewai/flow_states.db
SKILL_SANDBOX_TIMEOUT_SECONDS=30
SKILL_SANDBOX_MEMORY_MB=256
SKILL_SANDBOX_CPUS=0.5
SKILL_SANDBOX_PIDS_LIMIT=64
SKILL_SANDBOX_MAX_STDOUT_BYTES=262144
SKILL_SANDBOX_MAX_STDERR_BYTES=262144
